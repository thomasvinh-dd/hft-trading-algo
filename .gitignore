# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtualenv
.venv/
venv/
env/

# Secrets / env files
vietnam_algo/env/*
# ...but the credentials TEMPLATE is tracked (the real file is not).
!vietnam_algo/env/.env.autofin-signal.example
.env
.env.*

# Data — never commit (large + may contain PII)
vietnam_algo/data/
data/
# Price history is fetched by the VPS sync job. It was tracked before
# the rules above existed (commit ed16cff "init strategy algo"), which
# caused a 2026-11-01 deploy to push stale local copies over the VPS's
# fresh ones and rewind the market data by three months. Keep it
# untracked — the VPS owns this data.
vietnam_algo/data/prices/
vietnam_algo/data/live/

# Logs
logs/
*.log

# Backups / runtime artifacts
backups/
*.pyc.bak

# Secrets left at project root — DO NOT COMMIT
dnse.txt
# Off-site git bundles pulled down from the VPS
.vps-backups/
